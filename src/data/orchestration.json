{
  "stages": [
    {
      "step": 1,
      "label": "Supply evidence",
      "phase": "Evidence",
      "description": "Collect the asset record, service history, BOM, contract and bin location for the returned unit.",
      "performerId": "evidence-agent",
      "systems": ["EAM", "PLM / quality", "ERP", "WMS"],
      "owner": "Planner",
      "control": "Evidence completeness gate (70% minimum)",
      "human": false,
      "spans": [
        { "kind": "agent", "name": "evidence_agent.plan", "params": "case={caseId}" },
        { "kind": "tool", "name": "eam.get_asset", "params": "assetTag={assetTag}" },
        { "kind": "tool", "name": "plm.get_bom", "params": "model={model}" },
        { "kind": "tool", "name": "erp.get_contract", "params": "tenant={tenant}" },
        { "kind": "tool", "name": "wms.get_bin", "params": "bin={bin}" },
        { "kind": "audit", "name": "ledger.append", "params": "event=evidence_supplied" }
      ]
    },
    {
      "step": 2,
      "label": "Build alternatives",
      "phase": "Evaluate",
      "description": "Link every eligible circularity route for the asset class and condition, applying tenant policy.",
      "performerId": "alternatives-builder",
      "systems": ["PLM / quality", "ERP"],
      "owner": "Planner",
      "control": "Tenant route policy",
      "human": false,
      "spans": [
        { "kind": "tool", "name": "policy.get_routes", "params": "class={productClass}" },
        { "kind": "agent", "name": "alternatives.build", "params": "condition={condition}" },
        { "kind": "audit", "name": "ledger.append", "params": "event=alternatives_built" }
      ]
    },
    {
      "step": 3,
      "label": "Predict outcomes",
      "phase": "Evaluate",
      "description": "Score resale price, refurbishment cost, failure risk and carbon for each route.",
      "performerId": "prediction-service",
      "systems": ["EAM", "Market data"],
      "owner": "Developer",
      "control": "Model registry: approved model versions only",
      "human": false,
      "spans": [
        { "kind": "model", "name": "price_model.predict", "params": "model=price-v7" },
        { "kind": "model", "name": "risk_model.predict", "params": "model=risk-v4" },
        { "kind": "model", "name": "carbon_model.estimate", "params": "model=carbon-v2" },
        { "kind": "audit", "name": "ledger.append", "params": "event=outcomes_predicted" }
      ]
    },
    {
      "step": 4,
      "label": "Optimise plan",
      "phase": "Decide",
      "description": "Choose the route with the best net recovery within site capacity and the economics gate.",
      "performerId": "plan-optimiser",
      "systems": ["ERP", "WMS"],
      "owner": "Planner",
      "control": "Economics gate (net recovery above zero)",
      "human": false,
      "spans": [
        { "kind": "tool", "name": "wms.get_capacity", "params": "site={location}" },
        { "kind": "model", "name": "optimiser.solve", "params": "objective=net_recovery" },
        { "kind": "agent", "name": "plan_optimiser.explain", "params": "route={route}" },
        { "kind": "audit", "name": "ledger.append", "params": "event=plan_optimised" }
      ]
    },
    {
      "step": 5,
      "label": "Plan approval",
      "phase": "Approve",
      "description": "A named person signs off the plan. Nothing is sent to an operational system before this step.",
      "performerId": "approval-gate",
      "systems": ["Decision Workbench"],
      "owner": "Approver",
      "control": "Human approval: auto-approve below {autoApproveBelow} (Grade A), level 2 sign-off above {level2Above}, Executive above {delegationLimit}",
      "human": true,
      "spans": [
        { "kind": "human", "name": "approval.request", "params": "approver=Marcus Vance" },
        { "kind": "human", "name": "approval.decide", "params": "decision=approve" },
        { "kind": "audit", "name": "ledger.append", "params": "event=plan_approved" }
      ]
    },
    {
      "step": 6,
      "label": "Send instruction",
      "phase": "Execute",
      "description": "Transmit the approved plan to the operational systems through the MCP write gate.",
      "performerId": "instruction-dispatcher",
      "systems": ["EAM", "ERP", "MCP gateway"],
      "owner": "Developer",
      "control": "MCP write gate: approved plan id required",
      "human": false,
      "spans": [
        { "kind": "tool", "name": "mcp.write_gate.check", "params": "plan={caseId}-P1" },
        { "kind": "tool", "name": "eam.create_notification", "params": "assetTag={assetTag}" },
        { "kind": "audit", "name": "ledger.append", "params": "event=instruction_sent" }
      ]
    },
    {
      "step": 7,
      "label": "Create execution work",
      "phase": "Execute",
      "description": "Create the work order and the warehouse pick task for the chosen route.",
      "performerId": "work-order-agent",
      "systems": ["EAM", "WMS"],
      "owner": "Warehouse Manager",
      "control": "Site capacity check",
      "human": false,
      "spans": [
        { "kind": "tool", "name": "eam.create_work_order", "params": "route={route}" },
        { "kind": "tool", "name": "wms.create_pick_task", "params": "bin={bin}" },
        { "kind": "audit", "name": "ledger.append", "params": "event=work_created" }
      ]
    },
    {
      "step": 8,
      "label": "Repair & certify",
      "phase": "Execute",
      "description": "Track repair, test and certification until the unit is ready for its route.",
      "performerId": "certification-tracker",
      "systems": ["Test bench", "PLM / quality"],
      "owner": "Engineer",
      "control": "Quality certificate required before release",
      "human": false,
      "spans": [
        { "kind": "tool", "name": "testbench.get_results", "params": "serial={serial}" },
        { "kind": "tool", "name": "quality.issue_certificate", "params": "grade={condition}" },
        { "kind": "audit", "name": "ledger.append", "params": "event=certified" }
      ]
    },
    {
      "step": 9,
      "label": "Action & return outcome",
      "phase": "Reconcile",
      "description": "Collect the actual outcome (sale price, redeployment, recovery) from the systems that executed it.",
      "performerId": "outcome-collector",
      "systems": ["ERP", "WMS"],
      "owner": "Finance",
      "control": "Outcome must match a posted ERP document",
      "human": false,
      "spans": [
        { "kind": "tool", "name": "erp.get_billing_doc", "params": "case={caseId}" },
        { "kind": "tool", "name": "wms.get_dispatch", "params": "site={location}" },
        { "kind": "audit", "name": "ledger.append", "params": "event=outcome_returned" }
      ]
    },
    {
      "step": 10,
      "label": "Reconcile & learn",
      "phase": "Learn",
      "description": "Compare actual against predicted value and feed the variance back into the models.",
      "performerId": "reconciliation-service",
      "systems": ["ERP", "Model registry"],
      "owner": "Finance",
      "control": "Finance close sign-off",
      "human": false,
      "spans": [
        { "kind": "tool", "name": "erp.post_variance", "params": "case={caseId}" },
        { "kind": "model", "name": "registry.log_feedback", "params": "model=price-v7" },
        { "kind": "audit", "name": "ledger.append", "params": "event=reconciled" }
      ]
    }
  ],
  "agents": [
    {
